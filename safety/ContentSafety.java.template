package com.moviebox.tv;
import org.json.*;
import java.text.Normalizer;
import java.util.*;
import java.util.regex.Pattern;

/** Generated from safety/policy.json. Rules inspect metadata, not video or artwork. */
final class ContentSafety {
 static final JSONObject POLICY;
 static {try{POLICY=new JSONObject(__POLICY__);}catch(Exception e){throw new ExceptionInInitializerError(e);}}
 static final String MESSAGE=POLICY.optString("message"),UNVERIFIED=POLICY.optString("unverified");
 static final class Blocked extends IllegalArgumentException {Blocked(){super(MESSAGE);}}
 // Reuse Unicode patterns: compiling them for every index entry stalls older Android devices.
 private static final Pattern MARKS=Pattern.compile("[\\p{M}\\p{Cf}]");
 private static final Pattern NON_ALNUM=Pattern.compile("[^\\p{L}\\p{N}]+");
 private static final Pattern SPACE=Pattern.compile("\\s+");
 static String normalize(String s){
  String value=MARKS.matcher(Normalizer.normalize(s,Normalizer.Form.NFKD).toLowerCase(Locale.ROOT)).replaceAll("")
   .replace('0','o').replace('1','i').replace('3','e').replace('4','a').replace('5','s').replace('7','t').replace('@','a').replace('$','s');
  return SPACE.matcher(NON_ALNUM.matcher(value).replaceAll(" ").trim()).replaceAll(" ");
 }
 static boolean contains(String s,String p){String a=normalize(s),b=normalize(p);return b.chars().anyMatch(c->c>127)?a.contains(b):(" "+a+" ").contains(" "+b+" ");}
 static final Pattern OBFUSCATED=Pattern.compile("(?:^|[^\\p{L}\\p{N}])h[\\W_]*[e3][\\W_]*n[\\W_]*t[\\W_]*[a4@][\\W_]*[i1](?:s)?(?:$|[^\\p{L}\\p{N}])");
 static final Pattern BADGE=Pattern.compile("(?:\\[|\\()\\s*(?:18\\s*\\+|adult|r\\s*-?\\s*18|nsfw)\\s*(?:\\]|\\))",Pattern.CASE_INSENSITIVE);
 static boolean listed(String key,String s){JSONArray list=POLICY.optJSONArray(key);for(int i=0;i<list.length();i++)if(contains(s,list.optString(i)))return true;return false;}
 static boolean member(String key,String s){JSONArray list=POLICY.optJSONArray(key);for(int i=0;i<list.length();i++)if(s.equals(list.optString(i)))return true;return false;}
 static boolean blockedText(String s){return OBFUSCATED.matcher(Normalizer.normalize(s,Normalizer.Form.NFKC).toLowerCase(Locale.ROOT)).find()||listed("phrases",s);}
 static List<String> strings(Object value){List<String> out=new ArrayList<>();if(value instanceof String)out.add((String)value);else if(value instanceof JSONArray){JSONArray a=(JSONArray)value;for(int i=0;i<a.length();i++)out.addAll(strings(a.opt(i)));}else if(value instanceof JSONObject){JSONObject o=(JSONObject)value;for(Iterator<String> it=o.keys();it.hasNext();){String k=it.next();if(!Arrays.asList("id","url","poster_url","image","poster","value").contains(k))out.addAll(strings(o.opt(k)));}}return out;}
 static final Set<String> ANIME_TITLES=new HashSet<>(),HAREM_TITLES=new HashSet<>();
 static final List<String> ANIME_LONG=new ArrayList<>();
 static synchronized void loadAnimeIndex(String json)throws Exception{if(!ANIME_TITLES.isEmpty())return;JSONObject index=new JSONObject(json);JSONArray titles=index.getJSONArray("titles");if(titles.length()<1000)throw new IllegalArgumentException("Incomplete explicit-anime index");ANIME_TITLES.clear();ANIME_LONG.clear();HAREM_TITLES.clear();JSONArray harem=index.optJSONArray("harem_titles");if(harem!=null)for(int i=0;i<harem.length();i++)HAREM_TITLES.add(normalize(harem.getString(i)));for(int i=0;i<titles.length();i++){String t=normalize(titles.getString(i));ANIME_TITLES.add(t);}for(String t:ANIME_TITLES)if(t.length()>=12&&t.split(" ").length>=2)ANIME_LONG.add(t);}
 static boolean animeContext(JSONObject v){for(String k:Arrays.asList("genres","genre","tags","category","categories"))for(String s:strings(v.opt(k)))for(String p:Arrays.asList("anime","animation","hentai"))if(contains(s,p))return true;for(String s:strings(v.opt("title")))if(contains(s,"anime edition")||contains(s,"the animation"))return true;return false;}
 static boolean indexedTitle(String s){String raw=Normalizer.normalize(s,Normalizer.Form.NFKC).replaceAll("(?i)[\\[(][^\\])]*(?:hindi|english|japanese|dubbed|subbed|1080|720|cam|bluray)[^\\])]*[\\])]"," ");String v=normalize(raw).replaceAll("\\s+(?:anime edition|the animation)$","");if(ANIME_TITLES.contains(v))return true;for(String t:ANIME_LONG)if(v.startsWith(t+" "))return true;return false;}
 static boolean sao(JSONObject v){String raw=Normalizer.normalize(v.optString("title"),Normalizer.Form.NFKC).replaceAll("(?i)[\\[(][^\\])]*(?:hindi|english|japanese|dubbed|subbed|1080|720|cam|bluray)[^\\])]*[\\])]"," ");return normalize(raw).equals("sword art online");}
 static boolean haremTitle(String s){String raw=Normalizer.normalize(s,Normalizer.Form.NFKC).replaceAll("(?i)[\\[(][^\\])]*(?:hindi|english|japanese|dubbed|subbed|1080|720|cam|bluray)[^\\])]*[\\])]"," ");return HAREM_TITLES.contains(normalize(raw));}
 static boolean blocked(JSONObject v){return blocked(v,false);}
 static boolean blocked(JSONObject v,boolean anime){if(v==null)return false;if(blocked(v.optJSONObject("item"),anime))return true;anime=anime||animeContext(v);if(anime){JSONArray titleFields=POLICY.optJSONArray("title_fields");for(int i=0;i<titleFields.length();i++)for(String s:strings(v.opt(titleFields.optString(i))))if(indexedTitle(s))return true;}if(!sao(v)){JSONArray ts=POLICY.optJSONArray("title_fields");for(int i=0;i<ts.length();i++)for(String s:strings(v.opt(ts.optString(i))))if(haremTitle(s))return true;}
  JSONArray flags=POLICY.optJSONArray("flag_fields");for(int i=0;i<flags.length();i++){Object f=v.opt(flags.optString(i));if(Boolean.TRUE.equals(f)||(f instanceof Number&&((Number)f).doubleValue()==1)||(f instanceof String&&Arrays.asList("true","yes","1").contains(((String)f).toLowerCase(Locale.ROOT))))return true;}
  JSONArray fields=POLICY.optJSONArray("text_fields");for(int i=0;i<fields.length();i++){String k=fields.optString(i);for(String text:strings(v.opt(k))){if(blockedText(text))return true;if(member("title_fields",k)&&(BADGE.matcher(Normalizer.normalize(text,Normalizer.Form.NFKC)).find()||listed("known_titles",text)))return true;if(member("category_fields",k)){if(!sao(v)){JSONArray h=POLICY.optJSONArray("harem_category_labels");for(String part:text.split("[,/|;]"))for(int j=0;j<h.length();j++)if(normalize(part).equals(normalize(h.optString(j))))return true;}JSONArray labels=POLICY.optJSONArray("category_labels");for(String part:text.split("[,/|;]"))for(int j=0;j<labels.length();j++)if(normalize(part).equals(normalize(labels.optString(j))))return true;}}}return false;
 }
 static String key(JSONObject v){if(v==null)return "";if(v.optJSONObject("item")!=null)return key(v.optJSONObject("item"));JSONObject id=v.optJSONObject("id");return id==null?"":id.optString("provider")+"\n"+id.optString("value");}
}
